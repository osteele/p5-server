{
  "name": "p5-analysis",
  "version": "0.6.10",
  "description": "API to find, create, and analyze p5.js sketch files.",
  "keywords": [
    "creative coding",
    "p5",
    "p5.js"
  ],
  "homepage": "https://osteele.github.io/p5-server/p5-analysis",
  "bugs": {
    "url": "https://github.com/osteele/p5-server/issues"
  },
  "license": "MIT",
  "author": "Oliver Steele <steele@osteele.com> (https://osteele.com/)",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "p5-analyze": "dist/bin/p5-analyze-cli.js",
    "p5-libraries": "dist/bin/p5-libraries-cli.js",
    "p5-library": "dist/bin/p5-libraries-cli.js",
    "p5-tree": "dist/bin/p5-tree-cli.js"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": "github:osteele/p5-server",
  "scripts": {
    "build": "bun run clean && bun run build:copy-files && tsc --declaration",
    "build:docs": "typedoc src/index.ts && bun run cli:libraries docs | pandoc -s --toc --shift-heading-level-by -1 > build/docs/libraries.html",
    "build:copy-files": "copyfiles -u 1 'src/**/*' -e '**/*.ts' dist/",
    "clean": "rimraf dist",
    "cli": "bun run --bun src/bin/p5-analyze-cli.ts",
    "cli:libraries": "bun run --bun src/bin/p5-libraries-cli.ts",
    "cli:library": "bun run --bun src/bin/p5-libraries-cli.ts",
    "cli:tree": "bun run --bun src/bin/p5-tree-cli.ts",
    "lint": "eslint --quiet src/**/*.ts tests/**/*.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "commander": "^11.1.0",
    "js-beautify": "^2.0.3",
    "lru-cache": "^11.5.2",
    "minimatch": "^10.2.6",
    "node-html-parser": "^9.0.1",
    "nunjucks": "^3.2.3",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/babel__traverse": "^7.28.0",
    "@types/copyfiles": "^2.4.4",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^20.19.43",
    "@types/nunjucks": "^3.2.6",
    "@types/pug": "^2.0.10",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
