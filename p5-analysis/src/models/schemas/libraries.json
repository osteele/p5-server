{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/product.schema.json",
  "title": "Libraries",
  "description": "A list of p5.js libraries",
  "type": "array",
  "items": {
    "type": "object",
    "uniqueItems": true,
    "properties": {
      "name": {
        "description": "The human-readable name of the library",
        "type": "string"
      },
      "homepage": {
        "description": "The library's home page",
        "type": "string",
        "pattern": "^https?:"
      },
      "repository": {
        "description": "The repository location, where this is different from the homepage",
        "type": "string",
        "pattern": "^https?:"
      },
      "description": {
        "description": "A short description of the library",
        "type": "string"
      },
      "importPath": {
        "description": "A CDN URL that loads the library",
        "type": "string",
        "pattern": "^https?:|^@"
      },
      "packageName": {
        "description": "NPM package name",
        "type": "string",
        "pattern": "^(?:@[a-zA-Z0-9][a-zA-Z0-9._~-]*/)?[a-zA-Z0-9][a-zA-Z0-9._~-]*$"
      },
      "defines": {
        "description": "Functions and property values",
        "type": "object",
        "additionalProperties": false,
        "patternProperties": {
          "globals|p5": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            }
          }
        },
        "items": {
          "type": "object"
        }
      },
      "lifecycle": {
        "type": "string",
        "enum": ["active", "maintenance", "legacy", "archived"]
      },
      "compatibility": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "p5Range": { "type": "string" },
            "confidence": {
              "type": "string",
              "enum": ["verified", "reported", "incompatible"]
            }
          },
          "required": ["p5Range", "confidence"]
        }
      },
      "inference": {
        "type": "string",
        "enum": ["automatic", "directive-only"]
      },
      "lastReviewed": {
        "type": "string",
        "format": "date"
      },
      "replacedBy": {
        "type": "string"
      }
    },
    "required": ["name", "homepage", "description"],
    "additionalProperties": false
  }
}
