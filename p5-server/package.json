{
  "name": "p5-server",
  "version": "1.0.1",
  "type": "module",
  "description": "p5.js development server with live reload, automatic library inclusion, and airplane mode, with CLI to create sketch files.",
  "keywords": [
    "creative coding",
    "live reload",
    "p5",
    "p5.js",
    "web server"
  ],
  "homepage": "https://osteele.github.io/p5-server/",
  "bugs": {
    "url": "https://github.com/osteele/p5-server/issues"
  },
  "license": "MIT",
  "author": "Oliver Steele <steele@osteele.com> (https://osteele.com/)",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "p5": "dist/bin/p5-server.js"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osteele/p5-server.git",
    "directory": "p5-server"
  },
  "scripts": {
    "build": "bun run clean && bun run build:client && bun run build:copy-files && tsc --declaration",
    "build:client": "node src/client/esbuild.config.js",
    "build:copy-files": "copyfiles -u 1 'src/**/*' -e '**/*.ts' dist/",
    "build:docs": "typedoc src/index.ts",
    "build:readme": "sed -f scripts/readme.sed < ../README.md > README.md",
    "clean": "rimraf dist 'src/server/static/*.min.js' 'src/server/static/*.min.js.map'",
    "cli": "bun run --bun src/bin/p5-server.ts",
    "_dev": "bun --watch src/bin/p5-server.ts serve",
    "dev": "bun run _dev examples",
    "lint": "biome check src tests --diagnostic-level=error",
    "postpack": "rm README.md",
    "prepack": "bun run clean && bun run build && bun run build:readme",
    "start": "bun run --bun src/bin/p5-server.ts server",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "watch:testdata": "bun run _dev tests/testdata"
  },
  "dependencies": {
    "cdn-proxy-cache": "^0.2.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "highlight.js": "^11.11.2",
    "livereload": "^0.10.3",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "marked-smartypants": "^1.1.12",
    "minimatch": "^10.2.6",
    "node-html-parser": "^9.0.1",
    "nunjucks": "^3.2.3",
    "open": "^11.0.0",
    "p5-analysis": "^1.0.0",
    "pug": "^3.0.4",
    "update-notifier": "^7.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.9",
    "@types/copyfiles": "^2.4.4",
    "@types/express": "^5.0.6",
    "@types/livereload": "^0.9.5",
    "@types/node": "^20.19.43",
    "@types/nunjucks": "^3.2.6",
    "@types/pug": "^2.0.10",
    "@types/update-notifier": "^6.0.8",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
